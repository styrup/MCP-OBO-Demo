# Copy this file to .env (same folder as docker-compose.yml) and fill in real
# values. .env is git-ignored - never commit real secrets.

# --- McpDummyServer (EntraId section) ---
# Leave TenantId/Audience empty to run the HTTP MCP endpoint unauthenticated
# (fine for local learning, not for anything else).
ENTRAID__TENANTID=
ENTRAID__AUDIENCE=
ENTRAID__TOKENAUDIENCE=
ENTRAID__SCOPE=mcp.tools
ENTRAID__CLIENTID=
ENTRAID__CLIENTSECRET=
ENTRAID__DOWNSTREAMSCOPE=https://graph.microsoft.com/User.Read
ENTRAID__CUSTOMAPISCOPE=

# --- DownstreamSampleApi (its own, separate EntraId app registration) ---
DOWNSTREAM__ENTRAID__TENANTID=
DOWNSTREAM__ENTRAID__AUDIENCE=
DOWNSTREAM__ENTRAID__TOKENAUDIENCE=
